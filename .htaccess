Options -Indexes
DirectorySlash Off
RewriteEngine On

# Force HTTPS (skipped for local testing)
RewriteCond %{HTTP_HOST} !^(localhost|127\.)
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www -> apex
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Redirect /page/ -> /page (no trailing slash, root excluded)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Redirect /index.html and /page/index.html -> / and /page
RewriteCond %{THE_REQUEST} \s/([^\s?]*/)?index\.html[\s?]
RewriteRule ^(.*?)/?index\.html$ /$1 [R=301,L]

# Redirect direct /page.html requests -> /page (old links and QR codes keep working)
RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# Serve directory index for extensionless URLs (/order -> /order/index.html)
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ $1/index.html [L]

# Serve root-level .html files extensionless (/watch-party-rsvp -> watch-party-rsvp.html)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

ErrorDocument 404 /404.html
